{
  "compilerOptions": {
    "baseUrl": ".",

    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "types": [
      "vite/client"
    ],

    "ignoreDeprecations": "6.0",

    "target": "es2023",

    "lib": [
      "ES2023",
      "DOM"
    ],

    "module": "esnext",

    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "noEmit": true
  },

  "include": [
    "src"
  ]
}